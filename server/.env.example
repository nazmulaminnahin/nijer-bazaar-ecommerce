# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nijer_bazaar
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nijer_bazaar
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_for_customers_min_32_chars
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=your_super_secret_admin_jwt_key_min_32_chars
JWT_ADMIN_EXPIRES_IN=1d

# Client URL
CLIENT_URL=http://localhost:5173

# Email Configuration (Optional - for future features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
